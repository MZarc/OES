# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=oes_super_secret_session_key_min_32_chars_long_12345
BETTER_AUTH_URL=http://localhost:3000

# Database (PostgreSQL - Supabase in production, local Postgres in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oes_db

# Valkey / Redis (BullMQ Queue)
VALKEY_URL=redis://localhost:6379

# Object Storage (MinIO local / Cloudflare R2 in production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=oes-receipts
STORAGE_PUBLIC_URL=http://localhost:9000/oes-receipts

# Email (SMTP / Mailpit for local dev, Brevo/Gmail for production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OES Admin <notifications@oes.local>"

# Organization Default Settings
DEFAULT_TIMEZONE=Asia/Kolkata

# Live Demo Sandbox Card toggle (set to 'true' to display 1-click Demo credentials card on login page, 'false' in strict corporate production)
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

